<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="style.css" />
    <title>RobCo</title>
  </head>
  <script>
    async function loadRecent() {
      try {
        const res = await fetch("/api/scoreboard");
        if (!res.ok) throw new Error("Failed to fetch recent games");
        const data = await res.json(); // [{ finished_at }, ...]

        const list = document.querySelector("#recent-list");
        if (!Array.isArray(data) || !list) return;

        list.innerHTML = data
          .map((row) => {
            const local = row.finished_at
              ? new Date(row.finished_at).toLocaleString()
              : "—";
            return `<li>${local}</li>`;
          })
          .join("");
      } catch (err) {
        console.error(err);
      }
    }

    loadRecent();
  </script>

  <body>
    <div class="crt">
      <div class="container">
        <div class="game">
          <h1>Welcome to RobCo Terminal</h1>
          <form action="/guess" method="post">
            <input type="text" name="guess" maxlength="5" required />
            <button type="submit">Guess</button>
          </form>
          <% attempts.forEach(function(attempt) { %>
          <p><%= attempt.guess %> : <%= attempt.feedback %></p>
          <% }); %>
        </div>
        <div class="hints">
          <p><%= mixedSymbols %></p>
        </div>
        <hr />
        <section id="scoreboard">
          <h2>Recent Games</h2>
          <ol id="recent-list" class="recent-list"></ol>
        </section>
      </div>
    </div>
  </body>
</html>
